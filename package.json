{
  "name": "klad-monorepo",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @klad/playground dev",
    "docs": "pnpm --filter @klad/docs dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "check:packages": "turbo run build && node scripts/check-packages.mjs && node scripts/check-published-types.mjs",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint packages --type-aware",
    "format": "prettier --write \"packages/**/*.{ts,tsx,vue,json,md}\" \"scripts/**/*.mjs\" \"*.md\"",
    "format:check": "prettier --check \"packages/**/*.{ts,tsx,vue,json,md}\" \"scripts/**/*.mjs\" \"*.md\"",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.20.3",
    "@vitest/browser": "^5.0.1",
    "@vitest/browser-playwright": "5.0.1",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "playwright": "^1.63.0",
    "prettier": "^3.9.7",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "turbo": "^2.10.13",
    "typescript": "7.0.2",
    "vitest": "^5.0.1"
  }
}
